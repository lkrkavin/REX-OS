[Unit]
Description=REX OS Daemon - System health monitoring and AI orchestrator
Documentation=file:///opt/rex-os/services/rex_daemon.py
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rex-os/services/rex_daemon.py
WorkingDirectory=/var/lib/rex
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rex-os
User=rex
Group=rex

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/rex

# Restart behavior
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rex-daemon

[Install]
WantedBy=multi-user.target