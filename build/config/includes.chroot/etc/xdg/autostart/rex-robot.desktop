[Desktop Entry]
Type=Application
Name=REX Robot
Comment=REX OS floating robot assistant
Exec=/usr/bin/python3 /opt/rex-os/ui/rex_robot.py
TryExec=/usr/bin/python3
Hidden=false
NoDisplay=false
OnlyShowIn=KDE;
X-GNOME-Autostart-enabled=true
